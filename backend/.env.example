PORT=3001
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=smart-watchlist-dev-jwt-secret-key-32charsmin!
# If DATABASE_URL is not set, the app will automatically use embedded PGlite (genuine Postgres engine in Node.js)
# DATABASE_URL=postgres://user:password@localhost:5432/watchlist
# If REDIS_URL is not set, the app will automatically use in-memory Redis adapter with pub/sub
# REDIS_URL=redis://localhost:6379
POLL_INTERVAL_MS=3000
SNAPSHOT_INTERVAL_MS=15000
SIGNIFICANCE_THRESHOLD=1.5
VOLATILITY_FLOOR=0.2
